# ─────────────────────────────────────────────
#  Dementia AI Companion – Environment Variables
#  Copy this file, rename to .env, fill values.
# ─────────────────────────────────────────────

# REQUIRED: Gemini 1.5 Flash (primary LLM)
# Get from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=your-gemini-api-key-here

# OPTIONAL: NVIDIA NIM (fallback LLM, 1000 free calls)
# Get from: https://build.nvidia.com → API Keys
NVIDIA_API_KEY=your-nvidia-api-key-here

# REQUIRED: Hugging Face (model downloads – Whisper, embedders)
# Get from: https://huggingface.co/settings/tokens → New token (read)
HF_TOKEN=your-huggingface-token-here

# ─── App Settings ────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ─── Storage Paths ───────────────────────────
DB_PATH=data/companion.db
CHROMA_PATH=data/chroma

# ─── Speech Settings ─────────────────────────
# Options: tiny, base, small, medium  (base recommended for CPU)
WHISPER_MODEL=base

# ─── Language Settings ───────────────────────
# Primary language for prompts: en, hi, as (Assamese), bn (Bengali)
PRIMARY_LANG=en

# ─── Analytics Settings ──────────────────────
# Minimum sessions before baseline is considered established
BASELINE_MIN_SESSIONS=1
# Z-score thresholds for alert levels
ALERT_MILD_ZSCORE=1.5
ALERT_MODERATE_ZSCORE=2.5
ALERT_MAJOR_ZSCORE=3.5
