# ============================================================================
# SmritiSetu AI — Environment Variables (example; contains NO real secrets)
# Copy to .env and fill in. Never commit a real .env.
# ============================================================================

# ---------- PostgreSQL (docker-compose service `postgres`) ----------
POSTGRES_USER=smritisetu
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=smritisetu
POSTGRES_PORT=5432

# ---------- Backend API (services/backend-api) ----------
# Inside docker-compose use host `postgres`; on the host machine use `localhost`.
DATABASE_URL=postgresql://smritisetu:change_me_local_dev_only@localhost:5432/smritisetu?schema=public
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
DEVICE_TOKEN_TTL=180d

# Security
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
BCRYPT_ROUNDS=10

# ---------- Media storage ----------
# Prototype uses local disk + signed URLs. For production point this at S3/GCS
# and set MEDIA_DRIVER=s3 plus the credentials below.
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./storage/media
MEDIA_SIGNING_SECRET=dev_media_signing_secret_change_me
MEDIA_URL_TTL_SECONDS=3600
MEDIA_MAX_UPLOAD_BYTES=10485760
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=            <-- REAL CREDENTIAL GOES HERE (never commit)
# S3_SECRET_ACCESS_KEY=        <-- REAL CREDENTIAL GOES HERE (never commit)

# ---------- Push notifications (Firebase Cloud Messaging) ----------
# Prototype logs notifications to the console when FCM_ENABLED=false.
FCM_ENABLED=false
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=             <-- REAL CREDENTIAL GOES HERE (escape newlines as \n)

# ---------- ML service ----------
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=4000
# The /v1/personalisation/plan call may go through Gemini, so it gets longer.
ML_SESSION_PLAN_TIMEOUT_MS=15000
ML_SERVICE_ENABLED=true

# ---------- ML service internals (services/ml-service) ----------
ML_PORT=8000
ML_LOG_LEVEL=info
ML_MIN_DIFFICULTY=1
ML_MAX_DIFFICULTY=4
ML_ANOMALY_ENABLED=true
ML_ANOMALY_MIN_BASELINE=12

# Optional Gemini session planner (POST /v1/personalisation/plan). Softens the
# rule-based plan only; never raises difficulty. Blank key = rules-only.
ML_GEMINI_ENABLED=true
GEMINI_API_KEY=                # <-- REAL CREDENTIAL GOES HERE (never commit); AIza... key or OAuth token
ML_GEMINI_MODEL=gemini-2.5-flash

# ---------- Custom accessibility voice (services/tts-service) ----------
# Narration in a caregiver's own voice, cloned once from a single 30–45 second
# recording. Set TTS_ENABLED=false and the app narrates with the device's own
# speech engine exactly as before — no model download required.
# Full documentation: services/tts-service/README.md
TTS_ENABLED=true
TTS_PORT=8100
TTS_LOG_LEVEL=info
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_DEVICE=auto
# Qwen3-TTS does not speak Assamese or the other North Eastern languages; those
# keep the device's own voice rather than being mispronounced.
TTS_SUPPORTED_LANGUAGES=en
# The reference recording stays on the server. It is never committed, logged or
# returned to a client. Place it with:
#   python services/tts-service/scripts/prepare_reference_voice.py --input <file>
TTS_REFERENCE_AUDIO=./voices/my_voice.wav
TTS_REFERENCE_TEXT=./voices/my_voice.txt
# Generated clips may carry a patient's name, so they are swept. Pre-generated
# static narration lives elsewhere and is never removed by this.
TTS_AUDIO_RETENTION_HOURS=24
TTS_MAX_TEXT_LENGTH=1200
# Leave blank on a development network; set it for anything exposed.
TTS_API_KEY=

# ---------- Alert engine ----------
ALERT_MISSED_CRITICAL_THRESHOLD=2
ALERT_INACTIVITY_HOURS=48
ALERT_NO_SYNC_HOURS=72
ALERT_ABANDON_THRESHOLD=3

# ---------- Patient mobile app (apps/patient-mobile/.env) ----------
# Use your machine's LAN IP (not localhost) when running on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_DEMO_PAIRING_CODE=123456
EXPO_PUBLIC_TTS_API_URL=http://localhost:8100
EXPO_PUBLIC_TTS_ENABLED=true
