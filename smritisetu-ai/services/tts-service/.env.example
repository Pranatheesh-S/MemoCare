# Custom accessibility voice service. Copy to .env for local development.
# No real secret and no personal path belongs in this file.

# Turn the whole thing off and the app narrates exactly as it did before, with
# the device's own speech engine. Nobody needs to download a model to work on
# the rest of the application.
TTS_ENABLED=true
TTS_PORT=8100
TTS_LOG_LEVEL=info

# ---------- model ----------
# Qwen3-TTS voice-clone models. 0.6B is the lighter one and is the sensible
# default on a laptop; 1.7B is closer to the reference voice on a GPU.
#   Qwen/Qwen3-TTS-12Hz-0.6B-Base
#   Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# auto -> CUDA if present, then Apple Metal, then CPU. No GPU is assumed.
TTS_DEVICE=auto

# ---------- language ----------
# Qwen3-TTS speaks Chinese, English, Japanese, Korean, German, French, Russian,
# Portuguese, Spanish and Italian. Assamese and the other North Eastern
# languages are NOT among them, so they keep the device's own speech engine
# rather than being mispronounced by a cloned voice. Add a code here only if
# the model genuinely speaks it.
TTS_LANGUAGE=en
TTS_SUPPORTED_LANGUAGES=en

# ---------- the reference voice ----------
# One recording of roughly 30–45 seconds, and the exact words spoken in it.
# Both stay on the server. They are never uploaded, logged or served.
# Prepare them with: python scripts/prepare_reference_voice.py --input <file>
TTS_REFERENCE_AUDIO=./voices/my_voice.wav
TTS_REFERENCE_TEXT=./voices/my_voice.txt
TTS_REF_MIN_SECONDS=5
TTS_REF_MAX_SECONDS=120

# ---------- output ----------
TTS_OUTPUT_DIR=./generated
TTS_STATIC_OUTPUT_DIR=./static_audio
# Generated clips are swept on this schedule. Pre-generated static voice-overs
# live in a separate directory and are never removed by it.
TTS_AUDIO_RETENTION_HOURS=24
TTS_CACHE_MAX_ENTRIES=500

# ---------- request limits ----------
TTS_MAX_TEXT_LENGTH=1200
TTS_CHUNK_MAX_CHARS=240

# ---------- playback advice for the client ----------
# Rate is applied by the player, never by stretching the waveform — stretching
# degrades a cloned voice. A calm pace should come from the recording itself.
TTS_SPEECH_RATE=1.0
TTS_AUTOPLAY=true
TTS_FALLBACK_SYSTEM_VOICE=true

# ---------- security ----------
# Leave blank on a development machine. Set it for anything reachable beyond
# your own network, and set EXPO_PUBLIC_TTS_API_KEY to match in the app.
TTS_API_KEY=
TTS_CORS_ORIGINS=*

# ---------- static generation ----------
# The app's own locale files are the source of every fixed sentence, so no
# spoken string is ever written down twice.
TTS_LOCALES_DIR=../../apps/patient-mobile/locales
TTS_APP_VOICE_DIR=../../apps/patient-mobile/assets/voice
