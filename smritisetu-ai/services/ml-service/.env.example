# ML personalisation service. Every threshold is configurable; defaults are
# deliberately cautious. Copy to .env for local development.
ML_PORT=8000
ML_LOG_LEVEL=info

# Difficulty range. Difficulty never moves more than one level at a time.
ML_MIN_DIFFICULTY=1
ML_MAX_DIFFICULTY=4

# Adaptation rule thresholds
ML_INCREASE_ACCURACY=0.80
ML_INCREASE_MIN_SESSIONS=3
ML_DECREASE_ACCURACY=0.50
ML_DECREASE_MIN_SESSIONS=2
ML_HINT_THRESHOLD=2.0
ML_HINT_MIN_SESSIONS=3
ML_ABANDONMENT_THRESHOLD=2
ML_ABANDONMENT_WINDOW=5
ML_MAX_HINT_LEVEL=3

# Trend thresholds. A single poor session must never raise an observation, so
# both a minimum session count and a minimum number of moving indicators apply.
ML_TREND_MIN_SESSIONS=5
ML_TREND_MIN_INDICATORS=2
ML_TREND_ACCURACY_DROP=0.15
ML_TREND_HINT_INCREASE=1.0
ML_TREND_RESPONSE_INCREASE=0.40
ML_TREND_ABANDONMENT_RATE=0.30
ML_TREND_ADHERENCE_DROP=0.30

# Optional anomaly detector — a secondary signal only; it can withhold a
# difficulty increase but can never cause one.
ML_ANOMALY_ENABLED=true
ML_ANOMALY_MIN_BASELINE=12
ML_ANOMALY_CONTAMINATION=0.1

# Optional Gemini session planner for POST /v1/personalisation/plan. It only
# ever softens the rule-based plan (fewer items, more preview time, shorter
# session, a calmer follow-up); it can never raise difficulty or remove hint
# support, and every string it returns is re-checked by the safety guard.
# Leave GEMINI_API_KEY blank to run the planner on deterministic rules alone.
ML_GEMINI_ENABLED=true
GEMINI_API_KEY=                 # <-- Gemini API key (sent as x-goog-api-key); REAL VALUE, never commit
ML_GEMINI_MODEL=gemini-2.5-flash
ML_GEMINI_TIMEOUT_MS=12000
# ML_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
