{
  "name": "remi-patient",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --import ./src/testing/register.mjs \"src/**/__tests__/*.test.ts\"",
    "lint": "tsc --noEmit",
    "test:integration": "SMRITISETU_STUB_NATIVE=1 node --test --experimental-strip-types --import ./src/testing/register.mjs \"src/integration/*.test.ts\""
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@smritisetu/shared-types": "^1.0.0",
    "@tanstack/react-query": "^5.102.3",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-speech": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  }
